# name: test/sql/create_index.test
# description: create_ngram_index / drop_ngram_index / ngram_index_stats lifecycle
# group: [sql]

require ngram

statement ok
CREATE TABLE docs(id INTEGER, s VARCHAR, n INTEGER, t VARCHAR);

statement ok
INSERT INTO docs VALUES
	(1, 'Hello world', 10, NULL),
	(2, 'hello DUCK', 20, NULL),
	(3, NULL, 30, NULL),
	(4, 'ab', 40, NULL),
	(5, 'connection reset by peer', 50, NULL),
	(6, 'öft ÖFT often', 60, NULL);

statement ok
PRAGMA create_ngram_index('docs', 's');

statement ok
SET VARIABLE docs_s_id = (SELECT replace(index_id::VARCHAR, '-', '')
                              FROM __ngram.registry WHERE table_name = 'docs' AND column_name = 's');

# the segments and stats tables exist, named by the index id
query I
SELECT count(*) FROM duckdb_tables()
WHERE schema_name = '__ngram' AND table_name IN ('segments_' || getvariable('docs_s_id'), 'stats_' || getvariable('docs_s_id'));
----
2

# options round-trip through the registry row
query IIIIII
SELECT format_version, schema_name, table_name, column_name, gram_size, case_insensitive
FROM (SELECT * FROM __ngram.registry WHERE replace(index_id::VARCHAR, '-', '') = getvariable('docs_s_id'));
----
4	main	docs	s	3	true

# hwm covers all rows at build time
query I
SELECT hwm_rowid = (SELECT max(rowid) FROM docs)
FROM (SELECT * FROM __ngram.registry WHERE replace(index_id::VARCHAR, '-', '') = getvariable('docs_s_id'));
----
true

# the index is exactly the brute-force extraction (both directions)
query I
SELECT count(*) FROM (
	(SELECT gram, unnest(ngram_decode_postings(postings)) rid
	 FROM query('SELECT * FROM __ngram.segments_' || getvariable('docs_s_id'))
	 EXCEPT SELECT DISTINCT unnest(trigrams(s)) gram, rowid FROM docs WHERE s IS NOT NULL)
	UNION ALL
	(SELECT DISTINCT unnest(trigrams(s)) gram, rowid FROM docs WHERE s IS NOT NULL
	 EXCEPT SELECT gram, unnest(ngram_decode_postings(postings)) rid
	 FROM query('SELECT * FROM __ngram.segments_' || getvariable('docs_s_id')))
);
----
0

# stats agree with the segments table
query I
SELECT count(*) FROM query('SELECT * FROM __ngram.stats_' || getvariable('docs_s_id'));
----
44

query II
SELECT row_count, segment_count
FROM query('SELECT * FROM __ngram.stats_' || getvariable('docs_s_id')) WHERE gram = 'hel';
----
2	1

# duplicate create errors
statement error
PRAGMA create_ngram_index('docs', 's');
----
already exists

# missing table / missing column / wrong type errors
statement error
PRAGMA create_ngram_index('nope', 's');
----
does not exist

statement error
PRAGMA create_ngram_index('docs', 'nope');
----
does not have a column

statement error
PRAGMA create_ngram_index('docs', 'n');
----
VARCHAR

statement error
PRAGMA create_ngram_index('docs', 's', gram = 0);
----
at least 1

# stats on an unindexed table errors
statement error
PRAGMA ngram_index_stats('unindexed');
----
does not exist

statement ok
CREATE TABLE unindexed(s VARCHAR);

statement error
PRAGMA ngram_index_stats('unindexed');
----
No ngram indexes

# The first index creates the table's one rowid guard, covering every VARCHAR
# present at that moment; a later index on such a column records the same
# guard and runs no barrier. Updating that column is therefore already
# delete+insert and advances the first index's tail.
statement ok
UPDATE docs SET t = 'tent often entered';

statement ok
PRAGMA create_ngram_index('docs', 't', gram = 2, case_insensitive = false);

query III
SELECT count(*), count(DISTINCT guard_name), count(DISTINCT guard_token) FROM __ngram.registry WHERE table_name = 'docs';
----
2	1	1

query II
SELECT (SELECT count(*) FROM duckdb_tables() WHERE schema_name = '__ngram' AND table_name <> 'registry'),
       (SELECT count(*) FROM duckdb_indexes() WHERE table_name = 'docs');
----
4	1

query IIIIIIIIIIIII
PRAGMA ngram_index_stats('docs');
----
s	3	true	5	11	6	44	44	0	1	48	136	NULL
t	2	false	11	11	0	12	12	0	1	72	96	NULL

# dropping one column's index leaves the other and the shared guard intact
statement ok
PRAGMA drop_ngram_index('docs', 's');

query II
SELECT (SELECT count(*) FROM duckdb_tables() WHERE schema_name = '__ngram' AND table_name <> 'registry'),
       (SELECT count(*) FROM duckdb_indexes() WHERE table_name = 'docs');
----
2	1

query IIIIIIIIIIIII
PRAGMA ngram_index_stats('docs');
----
t	2	false	11	11	0	12	12	0	1	72	96	NULL

# dropping the last index removes its storage tables and the table's guard
statement ok
PRAGMA drop_ngram_index('docs', 't');

query II
SELECT (SELECT count(*) FROM duckdb_tables() WHERE schema_name = '__ngram' AND table_name <> 'registry'),
       (SELECT count(*) FROM duckdb_indexes() WHERE table_name = 'docs');
----
0	0

# A VARCHAR added after the table's guard was created leaves the old index
# healthy but is outside the guard's coverage. Indexing it requires dropping
# the table's ngram indexes and rebuilding them.
statement ok
CREATE TABLE added_column(s VARCHAR);

statement ok
INSERT INTO added_column VALUES ('old needle');

statement ok
PRAGMA create_ngram_index('added_column', 's');

statement ok
ALTER TABLE added_column ADD COLUMN later VARCHAR;

statement ok
UPDATE added_column SET later='later needle';

statement ok
PRAGMA ngram_refresh('added_column');

statement error
PRAGMA create_ngram_index('added_column', 'later');
----
drop the table's ngram indexes and rebuild them

statement ok
PRAGMA drop_ngram_index('added_column', 's');

statement ok
PRAGMA create_ngram_index('added_column', 's');

statement ok
PRAGMA create_ngram_index('added_column', 'later');

statement ok
UPDATE added_column SET later='updated later needle';

query I
SELECT count(*) FROM ngram_search('added_column', 'updated', col := 'later');
----
1

statement error
PRAGMA drop_ngram_index('docs', 's');
----
No ngram index

# DuckDB refuses to drop a guarded column. Dropping the ngram index first is
# the explicit lifecycle operation and accepts differently-cased spelling.
statement ok
CREATE TABLE orphan(id INTEGER, "Payload" VARCHAR);

statement ok
INSERT INTO orphan VALUES (1, 'a tent');

statement ok
PRAGMA create_ngram_index('orphan', 'Payload');

statement error
ALTER TABLE orphan DROP COLUMN "Payload";
----
index depends on it

statement ok
PRAGMA drop_ngram_index('orphan', 'PAYLOAD');

query I
SELECT count(*) FROM __ngram.registry WHERE table_name = 'orphan';
----
0

# index build on an empty table works and yields empty postings
statement ok
CREATE TABLE empty_docs(s VARCHAR);

statement ok
PRAGMA create_ngram_index('empty_docs', 's');

statement ok
SET VARIABLE empty_id = (SELECT replace(index_id::VARCHAR, '-', '')
                             FROM __ngram.registry WHERE table_name = 'empty_docs');

query IIII
SELECT hwm_rowid,
       (SELECT count(*) FROM query('SELECT * FROM __ngram.segments_' || getvariable('empty_id'))),
       (SELECT count(*) FROM query('SELECT * FROM __ngram.stats_' || getvariable('empty_id'))), gram_size
FROM (SELECT * FROM __ngram.registry WHERE replace(index_id::VARCHAR, '-', '') = getvariable('empty_id'));
----
-1	0	0	3

# NULL named parameters error instead of hitting an internal error
statement error
PRAGMA create_ngram_index('docs', 's', gram = NULL);
----
cannot be NULL

statement error
PRAGMA create_ngram_index('docs', 's', case_insensitive = NULL);
----
cannot be NULL

# a view is not an indexable target
statement ok
CREATE VIEW docs_view AS SELECT s FROM docs;

statement error
PRAGMA create_ngram_index('docs_view', 's');
----
view, not a table

# temporary tables are rejected up front
statement ok
CREATE TEMP TABLE temp_docs(s VARCHAR);

statement error
PRAGMA create_ngram_index('temp_docs', 's');
----
temporary

# a user column named rowid (any case) shadows the row-identifier pseudo-column,
# so the build would silently index that column's values; refuse instead
statement ok
CREATE TABLE has_rowid("RowID" BIGINT, s VARCHAR);

statement error
PRAGMA create_ngram_index('has_rowid', 's');
----
shadows the rowid pseudo-column

# evil identifiers: keyword column name, dotted table name, unicode column name
statement ok
CREATE TABLE "my.table"("select" VARCHAR, "sträße" VARCHAR);

statement ok
INSERT INTO "my.table" VALUES ('hello world', 'guten tag');

statement ok
PRAGMA create_ngram_index('"my.table"', 'select');

statement ok
PRAGMA create_ngram_index('"my.table"', 'sträße');

query IIIIIIIIIIIII
PRAGMA ngram_index_stats('"my.table"');
----
select	3	true	0	0	0	9	9	0	1	9	27	NULL
sträße	3	true	0	0	0	7	7	0	1	7	21	NULL

statement ok
PRAGMA drop_ngram_index('"my.table"', 'select');

statement ok
PRAGMA drop_ngram_index('"my.table"', 'sträße');

query I
SELECT count(*) FROM __ngram.registry WHERE table_name = 'my.table';
----
0

# Id-named storage cannot collide for (schema a, table b_c) and
# (schema a_b, table c).
statement ok
CREATE SCHEMA a;

statement ok
CREATE TABLE a.b_c(s VARCHAR);

statement ok
INSERT INTO a.b_c VALUES ('hello world');

statement ok
CREATE SCHEMA a_b;

statement ok
CREATE TABLE a_b.c(s VARCHAR);

statement ok
INSERT INTO a_b.c VALUES ('goodbye');

statement ok
PRAGMA create_ngram_index('a.b_c', 's');

statement ok
PRAGMA create_ngram_index('a_b.c', 's');

query IIIIIIIIIIIII
PRAGMA ngram_index_stats('a.b_c');
----
s	3	true	0	0	0	9	9	0	1	9	27	NULL

query I
SELECT count(DISTINCT index_id) FROM __ngram.registry
WHERE (schema_name = 'a' AND table_name = 'b_c') OR (schema_name = 'a_b' AND table_name = 'c');
----
2

statement ok
PRAGMA drop_ngram_index('a.b_c', 's');

statement ok
PRAGMA drop_ngram_index('a_b.c', 's');

# DuckDB folds only ASCII bytes for identifiers. SQL lower() is Unicode-aware,
# so owner keys must keep Ä and ä distinct identifiers.
statement ok
SET default_collation = 'nocase';

statement ok
CREATE TABLE "Ä"(s VARCHAR);

statement ok
INSERT INTO "Ä" VALUES ('a tent');

statement ok
PRAGMA create_ngram_index('"Ä"', 's');

statement ok
CREATE TABLE "ä"(s VARCHAR);

statement ok
INSERT INTO "ä" VALUES ('another tent');

statement ok
PRAGMA create_ngram_index('"ä"', 's');

query I
SELECT count(DISTINCT owner_key) FROM __ngram.registry WHERE table_name IN ('Ä', 'ä');
----
2

statement ok
PRAGMA drop_ngram_index('"Ä"', 's');

statement ok
PRAGMA drop_ngram_index('"ä"', 's');

statement ok
SET default_collation = 'binary';

# The SQL ownership guard used by drop follows the same ASCII case semantics.
statement ok
CREATE TABLE case_drop(s VARCHAR);

statement ok
INSERT INTO case_drop VALUES ('a tent');

statement ok
PRAGMA create_ngram_index('case_drop', 's');

statement ok
PRAGMA drop_ngram_index('CASE_DROP', 's');

query I
SELECT count(*) FROM __ngram.registry WHERE table_name = 'case_drop';
----
0

# Generated guards must not show up in pragma output or borrow user namespace.
# These are the deterministic scratch names used by older builds: every one is
# deliberately occupied, and the user's session variable is deliberately set.

# Current-schema macros must not be able to shadow internal runtime functions
# used by generated maintenance SQL.
statement ok
CREATE MACRO __ngram_maintenance_guard(a, b, c, d, e, f, g, h, i, j, k, l, m, n) AS error('shadow guard called');

statement ok
CREATE MACRO trigrams(a, b, c) AS error('shadow trigrams called');

statement ok
CREATE MACRO max(a) AS error('shadow max called');

statement ok
CREATE TABLE guard_output AS SELECT i AS id, 'row ' || i AS s FROM range(100) t(i);

statement ok
CREATE TEMP TABLE "__ngram_build_packed_ngram_main_guard_output_s"(marker INTEGER);

statement ok
CREATE TEMP TABLE "__ngram_refresh_packed_ngram_main_guard_output_s"(marker INTEGER);

statement ok
CREATE TEMP TABLE "__ngram_compact_keys_ngram_main_guard_output_s"(marker INTEGER);

statement ok
CREATE TEMP TABLE "__ngram_compact_packed_ngram_main_guard_output_s"(marker INTEGER);

statement ok
INSERT INTO "__ngram_build_packed_ngram_main_guard_output_s" VALUES (1);

statement ok
INSERT INTO "__ngram_refresh_packed_ngram_main_guard_output_s" VALUES (2);

statement ok
INSERT INTO "__ngram_compact_keys_ngram_main_guard_output_s" VALUES (3);

statement ok
INSERT INTO "__ngram_compact_packed_ngram_main_guard_output_s" VALUES (4);

statement ok
SET VARIABLE __ngram_guard = 'user-owned';

query I
PRAGMA create_ngram_index('guard_output', 's');
----

statement ok
INSERT INTO guard_output VALUES (1000, 'row tail');

query I
PRAGMA ngram_refresh('guard_output');
----

query I
PRAGMA ngram_compact('guard_output');
----

# the old scratch objects and the user's variable are byte-for-byte untouched
query II
SELECT getvariable('__ngram_guard') = 'user-owned',
       (SELECT sum(marker) FROM (
           SELECT * FROM "__ngram_build_packed_ngram_main_guard_output_s"
           UNION ALL SELECT * FROM "__ngram_refresh_packed_ngram_main_guard_output_s"
           UNION ALL SELECT * FROM "__ngram_compact_keys_ngram_main_guard_output_s"
           UNION ALL SELECT * FROM "__ngram_compact_packed_ngram_main_guard_output_s"));
----
true	10

# and it still fires: a second create is refused by the same guard expression
statement error
PRAGMA create_ngram_index('guard_output', 's');
----
An ngram index already exists on guard_output.s

# That error rolled its transaction back, including its UUID scratch table and
# transaction-owned vacuum fence. Only the four user tables remain, and a
# forced checkpoint can acquire the corresponding exclusive locks.
query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'temp' AND table_name LIKE '__ngram_%';
----
4

statement ok
FORCE CHECKPOINT;

query I
PRAGMA drop_ngram_index('guard_output', 's');
----

query I
SELECT getvariable('__ngram_guard') = 'user-owned';
----
true

statement ok
DROP TABLE "__ngram_build_packed_ngram_main_guard_output_s";

statement ok
DROP TABLE "__ngram_refresh_packed_ngram_main_guard_output_s";

statement ok
DROP TABLE "__ngram_compact_keys_ngram_main_guard_output_s";

statement ok
DROP TABLE "__ngram_compact_packed_ngram_main_guard_output_s";

statement ok
DROP MACRO __ngram_maintenance_guard;

statement ok
DROP MACRO trigrams;

statement ok
DROP MACRO max;

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'temp' AND table_name LIKE '__ngram_%';
----
0
