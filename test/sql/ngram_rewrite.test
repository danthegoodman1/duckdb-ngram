# name: test/sql/ngram_rewrite.test
# description: Correctness of the transparent optimizer rewrite: accelerated
# group: [sql]

# queries return exactly what the plain seq scan returns — false-positive
# traps rechecked away, query case semantics independent of index case
# folding, tail and transaction-local rows found, fallbacks exhaustive.

require ngram

statement ok
PRAGMA enable_verification

statement ok
CREATE TABLE docs(id INTEGER, s VARCHAR);

# rows 2 and 5 are false-positive traps for needle 'tent': they contain the
# grams 'ten' and 'ent' but not the substring
statement ok
INSERT INTO docs VALUES
	(1, 'Hello world'),
	(2, 'often entered'),
	(3, NULL),
	(4, ''),
	(5, 'ten cents'),
	(6, 'a tent pitched'),
	(7, 'TENT SHOUTING'),
	(8, 'öft ÖFT often'),
	(9, 'contentment'),
	(10, 'ab'),
	(11, 'connection reset by peer');

# case-insensitive index (the default)
statement ok
PRAGMA create_ngram_index('docs', 's');

# rows past the high-water mark must still be found
statement ok
INSERT INTO docs VALUES (12, 'tail tent row'), (13, 'tail noise'), (14, NULL);

statement ok
SET ngram_auto_accelerate = true;

statement ok
SET ngram_max_candidate_fraction = 1.0;

#===----------------------------------------------------------------------===#
# query case semantics never depend on index normalization
#===----------------------------------------------------------------------===#

# LIKE is case-sensitive: over the case-insensitive index the probe folds
# (superset), but recheck applies the case-sensitive predicate, so
# 'TENT SHOUTING' does not match
query II
SELECT id, s FROM docs WHERE s LIKE '%tent%' ORDER BY id;
----
6	a tent pitched
9	contentment
12	tail tent row

query II
SELECT id, s FROM docs WHERE contains(s, 'tent') ORDER BY id;
----
6	a tent pitched
9	contentment
12	tail tent row

# ILIKE is case-insensitive
query II
SELECT id, s FROM docs WHERE s ILIKE '%TeNt%' ORDER BY id;
----
6	a tent pitched
7	TENT SHOUTING
9	contentment
12	tail tent row

# unicode case folding through ILIKE
query II
SELECT id, s FROM docs WHERE s ILIKE '%öft%' ORDER BY id;
----
8	öft ÖFT often

#===----------------------------------------------------------------------===#
# multi-pattern LIKE: intersection narrows, recheck enforces segment order
#===----------------------------------------------------------------------===#

query II
SELECT id, s FROM docs WHERE s LIKE '%tail%tent%' ORDER BY id;
----
12	tail tent row

# same segments, other order: same candidates, recheck rejects them all
query II
SELECT id, s FROM docs WHERE s LIKE '%tent%tail%' ORDER BY id;
----

#===----------------------------------------------------------------------===#
# composite predicates, projections, joins, aggregates
#===----------------------------------------------------------------------===#

query II
SELECT id, s FROM docs WHERE s LIKE '%tent%' AND id > 6 ORDER BY id;
----
9	contentment
12	tail tent row

query II
SELECT id, s FROM docs WHERE s LIKE '%tent%' AND s LIKE '%pitched%' ORDER BY id;
----
6	a tent pitched

# projection excluding the searched column
query I
SELECT id FROM docs WHERE s LIKE '%tent%' ORDER BY id;
----
6
9
12

query I
SELECT count(*) FROM docs WHERE s LIKE '%tent%';
----
3

query I
SELECT rowid FROM docs WHERE s LIKE '%tent%' ORDER BY rowid;
----
5
8
11

query II
SELECT d.id, e.id FROM docs d JOIN docs e ON d.id + 3 = e.id WHERE d.s LIKE '%tent%' ORDER BY d.id;
----
6	9
9	12

query II
SELECT id, s FROM docs WHERE s LIKE '%tent%' ORDER BY id DESC LIMIT 2;
----
12	tail tent row
9	contentment

# disjunctions fall back (no rewrite) but stay correct
query II
SELECT id, s FROM docs WHERE contains(s, 'tent') OR contains(s, 'peer') ORDER BY id;
----
6	a tent pitched
9	contentment
11	connection reset by peer
12	tail tent row

#===----------------------------------------------------------------------===#
# identical results with the rewrite disabled, per kill switch
#===----------------------------------------------------------------------===#

statement ok
CREATE TEMP TABLE accelerated AS SELECT * FROM docs WHERE s ILIKE '%tent%';

statement ok
SET disabled_optimizers = 'extension';

statement ok
CREATE TEMP TABLE plain AS SELECT * FROM docs WHERE s ILIKE '%tent%';

statement ok
SET disabled_optimizers = '';

query I
SELECT count(*) FROM (
	(TABLE accelerated EXCEPT TABLE plain) UNION ALL (TABLE plain EXCEPT TABLE accelerated));
----
0

#===----------------------------------------------------------------------===#
# selectivity gate: fallback stays exhaustive
#===----------------------------------------------------------------------===#

statement ok
SET ngram_max_candidate_fraction = 0.0;

query II
SELECT id, s FROM docs WHERE s LIKE '%tent%' ORDER BY id;
----
6	a tent pitched
9	contentment
12	tail tent row

statement ok
SET ngram_max_candidate_fraction = 1.0;

#===----------------------------------------------------------------------===#
# transaction-local visibility
#===----------------------------------------------------------------------===#

statement ok
BEGIN;

statement ok
INSERT INTO docs VALUES (20, 'uncommitted tent sighting');

statement ok
DELETE FROM docs WHERE id = 9;

query II
SELECT id, s FROM docs WHERE s LIKE '%tent%' ORDER BY id;
----
6	a tent pitched
12	tail tent row
20	uncommitted tent sighting

statement ok
ROLLBACK;

query II
SELECT id, s FROM docs WHERE s LIKE '%tent%' ORDER BY id;
----
6	a tent pitched
9	contentment
12	tail tent row

# An index can include transaction-local inserts, but target-catalog DDL must
# be committed before the creation barrier starts.
statement ok
CREATE TABLE txn_docs(id INTEGER, s VARCHAR);

statement ok
BEGIN;

statement ok
INSERT INTO txn_docs VALUES (1, 'a tent inside'), (2, 'ten cents');

statement ok
PRAGMA create_ngram_index('txn_docs', 's');

query I
SELECT id FROM txn_docs WHERE s LIKE '%tent%';
----
1

statement ok
COMMIT;

#===----------------------------------------------------------------------===#
# DML over accelerated scans
#===----------------------------------------------------------------------===#

statement ok
CREATE TABLE dml(id INTEGER, s VARCHAR, flag INTEGER DEFAULT 0);

statement ok
INSERT INTO dml SELECT i, CASE WHEN i % 3 = 0 THEN 'a tent ' || i ELSE 'filler ' || i END, 0
	FROM range(1, 100) t(i);

statement ok
PRAGMA create_ngram_index('dml', 's');

statement ok
UPDATE dml SET flag = 1 WHERE s LIKE '%tent%';

query II
SELECT count(*), min(id % 3) FROM dml WHERE flag = 1;
----
33	0

statement ok
DELETE FROM dml WHERE s LIKE '%tent%';

query II
SELECT count(*), count(CASE WHEN id % 3 = 0 THEN 1 END) FROM dml;
----
66	0

# Indexed-column updates are delete+insert under the guard. The accelerated
# path sees their fresh rowids in the tail and stays identical to a seq scan.

statement ok
UPDATE dml SET s = s || ' grendel' WHERE id % 5 = 0;

query I
SELECT count(*) FROM dml WHERE s LIKE '%grendel%';
----
13

statement ok
SET disabled_optimizers = 'extension';

query I
SELECT count(*) FROM dml WHERE s LIKE '%grendel%';
----
13

statement ok
SET disabled_optimizers = '';

#===----------------------------------------------------------------------===#
# prepared statements across index drop and rebuild
#===----------------------------------------------------------------------===#

statement ok
PREPARE q AS SELECT id FROM docs WHERE s LIKE '%tent%' ORDER BY id;

query I
EXECUTE q;
----
6
9
12

# dropping the index bumps the catalog version, so the cached plan re-binds
# to a plain seq scan
statement ok
PRAGMA drop_ngram_index('docs', 's');

query I
EXECUTE q;
----
6
9
12

# rebuild with different options (case-sensitive, gram 4): re-bound again
statement ok
PRAGMA create_ngram_index('docs', 's', case_insensitive = false, gram = 4);

query I
EXECUTE q;
----
6
9
12

# flipping ngram_auto_accelerate does not bump the catalog version, so a
# cached plan keeps whatever scan was planned (the setting gates plan time,
# not execution); results are identical either way, pinned here
statement ok
SET ngram_auto_accelerate = false;

query I
EXECUTE q;
----
6
9
12

statement ok
SET ngram_auto_accelerate = true;

# the case-sensitive index serves LIKE but never ILIKE
query II
SELECT id, s FROM docs WHERE s LIKE '%tent%' ORDER BY id;
----
6	a tent pitched
9	contentment
12	tail tent row

query II
SELECT id, s FROM docs WHERE s ILIKE '%TENT%' ORDER BY id;
----
6	a tent pitched
7	TENT SHOUTING
9	contentment
12	tail tent row

#===----------------------------------------------------------------------===#
# a table with indexes on two columns: filters on either accelerate; results
# stay exact when both columns are filtered
#===----------------------------------------------------------------------===#

statement ok
CREATE TABLE two_cols(id INTEGER, a VARCHAR, b VARCHAR);

statement ok
INSERT INTO two_cols VALUES
	(1, 'alpha tent', 'north field'),
	(2, 'alpha barn', 'north tent'),
	(3, 'beta tent', 'south tent');

statement ok
PRAGMA create_ngram_index('two_cols', 'a');

statement ok
PRAGMA create_ngram_index('two_cols', 'b');

query I
SELECT id FROM two_cols WHERE a LIKE '%tent%' ORDER BY id;
----
1
3

query I
SELECT id FROM two_cols WHERE b LIKE '%tent%' ORDER BY id;
----
2
3

query I
SELECT id FROM two_cols WHERE a LIKE '%tent%' AND b LIKE '%south%';
----
3
