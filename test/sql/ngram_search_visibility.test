# name: test/sql/ngram_search_visibility.test
# description: ngram_search transaction visibility and staleness contract
# group: [sql]

# Covers uncommitted rows, deletes, updates, the high-water-mark tail, and an
# index created inside a still-open transaction.

require ngram

statement ok
CREATE TABLE docs(id INTEGER, s VARCHAR);

statement ok
INSERT INTO docs VALUES (1, 'a tent pitched'), (2, 'no match'), (3, 'ten cents');

statement ok
PRAGMA create_ngram_index('docs', 's');

# uncommitted inserts are visible to their own transaction only
statement ok con1
BEGIN;

statement ok con1
INSERT INTO docs VALUES (100, 'uncommitted tent row');

query I con1
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
1
100

query I con2
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
1

# rows deleted inside the transaction are not returned there but stay visible elsewhere
statement ok con1
DELETE FROM docs WHERE id = 1;

query I con1
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
100

query I con2
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
1

statement ok con1
ROLLBACK;

query I con1
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
1

# committed rows past the high-water mark are found without any refresh
statement ok con1
INSERT INTO docs VALUES (4, 'tent number two');

query I con2
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
1
4

query I con2
SELECT count(*) FROM (
	(SELECT * FROM ngram_search('docs', 'tent') EXCEPT SELECT * FROM docs WHERE contains(lower(s), 'tent'))
	UNION ALL
	(SELECT * FROM docs WHERE contains(lower(s), 'tent') EXCEPT SELECT * FROM ngram_search('docs', 'tent'))
);
----
0

# an update that removes the needle from an indexed row takes effect
# immediately: the stale candidate is eliminated by fetch + recheck
statement ok
UPDATE docs SET s = 'nothing here' WHERE id = 1;

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
4

# updates to rows past the high-water mark take effect immediately too: the
# tail scan reads them fresh
statement ok
UPDATE docs SET s = 'tent restored above hwm' WHERE id = 4;

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
4

# DOCUMENTED STALENESS GAP, unchanged by Phase 5 and unfixable on duckdb
# v1.5.5: an in-place UPDATE that introduces the needle into an
# already-indexed row (rowid <= hwm) is invisible to ngram_search. DuckDB
# updates rows in place (same rowid) unless an ART index forces
# delete+insert, and offers no trigger or change feed naming the updated rows
# (CREATE TRIGGER is a parser error), so there is nothing for an incremental
# refresh to read: refresh covers appends past the high-water mark only.
# Recheck still guarantees no false positives; a rebuild is the repair.
statement ok
UPDATE docs SET s = 'tent snuck into an indexed row' WHERE id = 2;

query I
SELECT id FROM docs WHERE contains(lower(s), 'tent') ORDER BY id;
----
2
4

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
4

# refresh cannot repair it — there is nothing to refresh, the row is below the
# high-water mark and the engine never reported the change — so it refuses
# rather than leaving the user with a refreshed-looking index that still
# misses rows. Here the update happened to hit one of the rows the index
# recorded as a witness, which is what makes the refusal possible at all; an
# update that misses every witness stays undetected (see ngram/maintenance.hpp).
statement error
PRAGMA ngram_refresh('docs');
----
no longer holds the value the index recorded

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
4

# the rebuild does
statement ok
PRAGMA drop_ngram_index('docs', 's');

statement ok
PRAGMA create_ngram_index('docs', 's');

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
2
4

statement ok
UPDATE docs SET s = 'no match' WHERE id = 2;

# searching inside the transaction that built the index works: the shadow
# tables are still transaction-local
statement ok con1
CREATE TABLE fresh(id INTEGER, s VARCHAR);

statement ok con1
INSERT INTO fresh VALUES (1, 'brand new tent'), (2, 'nothing');

statement ok con1
BEGIN;

statement ok con1
PRAGMA create_ngram_index('fresh', 's');

query I con1
SELECT id FROM ngram_search('fresh', 'tent');
----
1

# the other connection cannot see the index yet
statement error con2
SELECT * FROM ngram_search('fresh', 'tent');
----
no ngram index exists

statement ok con1
COMMIT;

query I con2
SELECT id FROM ngram_search('fresh', 'tent');
----
1

# a checkpoint between build and search does not disturb results on an
# append-only table (no deletes: vacuum cannot move rowids)
statement ok
INSERT INTO docs VALUES (5, 'tent after checkpoint');

statement ok
CHECKPOINT;

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
4
5

# PHASE 5 CHANGE (was: a silent miss — count 0 while the table holds a match).
# DROP TABLE leaves the shadow schema behind and the name-based ownership
# guard matches a re-created table of the same name, so searches still bind
# the dead index; they now refuse instead of answering from it. The proof is
# the table's catalog oid: it survives every ALTER but is handed out afresh by
# CREATE, so within the instance that recorded it a changed oid means the
# table was replaced. The index records the instance too, because oids are
# renumbered on restart — which is the residual gap: a same-shape re-creation
# performed in an earlier session is still undetectable (v1.5.5 persists no
# table identity token, and catalog ownership dependencies are in-memory
# only), and stays misses-only there.
statement ok
CREATE TABLE reborn(id INTEGER, s VARCHAR);

statement ok
INSERT INTO reborn VALUES (1, 'nothing here');

statement ok
PRAGMA create_ngram_index('reborn', 's');

statement ok
DROP TABLE reborn;

statement ok
CREATE TABLE reborn(id INTEGER, s VARCHAR);

statement ok
INSERT INTO reborn VALUES (1, 'a tent');

query I
SELECT count(*) FROM reborn WHERE contains(lower(s), 'tent');
----
1

statement error
SELECT count(*) FROM ngram_search('reborn', 'tent');
----
the table was dropped and re-created

statement error
PRAGMA ngram_refresh('reborn');
----
cannot be maintained incrementally

# the shadow schema is still droppable, and a rebuild adopts the new table
statement ok
PRAGMA drop_ngram_index('reborn', 's');

statement ok
PRAGMA create_ngram_index('reborn', 's');

query I
SELECT count(*) FROM ngram_search('reborn', 'tent');
----
1
