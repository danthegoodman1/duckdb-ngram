# name: test/sql/unpack_postings.test
# description: ngram_unpack_postings table function behavior
# group: [sql]

require ngram

# one row per posting, carrying its key: the reverse of the packing that
# compaction groups its output back through
query TII
SELECT gram, segment_no, r
FROM ngram_unpack_postings((
	SELECT gram, seg::BIGINT, ngram_encode_postings(rowids::BIGINT[])
	FROM (VALUES ('abc', 0, [1, 3]), ('abc', 1, [5]), ('xyz', 0, [2, 7, 9])) t(gram, seg, rowids)))
ORDER BY gram, segment_no, r;
----
abc	0	1
abc	0	3
abc	1	5
xyz	0	2
xyz	0	7
xyz	0	9

# round trip: unpack then re-pack reproduces the same postings, which is what
# compaction does to merge the segment rows sharing a key
query TIT
SELECT gram, segment_no, ngram_decode_postings(s.postings) FROM (
	SELECT gram, segment_no, ngram_pack_segment(r) AS s FROM ngram_unpack_postings((
		SELECT gram, seg::BIGINT, ngram_encode_postings(rowids::BIGINT[])
		FROM (VALUES ('abc', 0, [1, 3, 4]), ('abc', 0, [3, 9]), ('xyz', 0, [2])) t(gram, seg, rowids)))
	GROUP BY gram, segment_no)
ORDER BY gram, segment_no;
----
abc	0	[1, 3, 4, 9]
xyz	0	[2]

# an empty postings blob unpacks to nothing, and an empty input to nothing
query I
SELECT count(*) FROM ngram_unpack_postings((
	SELECT gram, seg::BIGINT, ngram_encode_postings([]::BIGINT[])
	FROM (VALUES ('abc', 0)) t(gram, seg)));
----
0

query I
SELECT count(*) FROM ngram_unpack_postings((SELECT ''::VARCHAR, 0::BIGINT, ''::BLOB WHERE false));
----
0

# a blob larger than one output chunk is emitted across several calls
query III
SELECT count(*), min(r), max(r) FROM ngram_unpack_postings((
	SELECT 'big', 0::BIGINT, (SELECT ngram_encode_postings(list(i)::BIGINT[]) FROM range(5000) t(i))));
----
5000	0	4999

# malformed blobs are rejected by the codec rather than decoded into garbage
statement error
SELECT * FROM ngram_unpack_postings((SELECT 'g'::VARCHAR, 0::BIGINT, 'garbage'::BLOB));
----
postings blob

statement error
SELECT * FROM ngram_unpack_postings((SELECT 'g'::VARCHAR, 0::BIGINT, ''::BLOB));
----
postings blob

# truncated: a count of 2 with only one delta present
statement error
SELECT * FROM ngram_unpack_postings((SELECT 'g'::VARCHAR, 0::BIGINT, '\x01\x02\x05'::BLOB));
----
malformed postings blob

# a NULL in any input column is refused: a posting with no key is meaningless
statement error
SELECT * FROM ngram_unpack_postings((SELECT NULL::VARCHAR, 0::BIGINT, ngram_encode_postings([1]::BIGINT[])));
----
must not contain NULLs

statement error
SELECT * FROM ngram_unpack_postings((SELECT 'g'::VARCHAR, NULL::BIGINT, ngram_encode_postings([1]::BIGINT[])));
----
must not contain NULLs

statement error
SELECT * FROM ngram_unpack_postings((SELECT 'g'::VARCHAR, 0::BIGINT, NULL::BLOB));
----
must not contain NULLs

# the input schema is checked at bind time
statement error
SELECT * FROM ngram_unpack_postings((SELECT 'g'::VARCHAR, 0::BIGINT));
----
expects a table of

statement error
SELECT * FROM ngram_unpack_postings((SELECT 0::BIGINT, 0::BIGINT, ngram_encode_postings([1]::BIGINT[])));
----
expects a table of

# a VARCHAR in the postings position is not silently decoded as a blob
statement error
SELECT * FROM ngram_unpack_postings((SELECT 'g'::VARCHAR, 0::BIGINT, 'not a blob'::VARCHAR));
----
expects a table of
