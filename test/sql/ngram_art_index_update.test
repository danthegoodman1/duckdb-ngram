# name: test/sql/ngram_art_index_update.test
# description: An ART index on the indexed column routes UPDATEs and vacuum away from the staleness gap
# group: [sql]

require ngram

# docs/stale-updates.md Option D rests on two upstream behaviours, and its whole
# value is that neither needs code here. Both are internals rather than
# documented contract, so this file pins them: if a DuckDB bump changes either,
# the recommendation in the README stops being true and this fails loudly
# instead of quietly becoming bad advice.
#
#   1. TableCatalogEntry::BindUpdateConstraints turns an UPDATE into a delete
#      plus an insert when the updated column is in some index's column set
#      (catalog_entry/table_catalog_entry.cpp). The rewritten row leaves its old
#      rowid for a fresh one past the high-water mark, which is the tail — a
#      place this extension already covers exactly.
#   2. RowGroupCollection::InitializeVacuumState only relocates rowids when the
#      table carries no ART index (row_group_collection.cpp), so any ART index
#      stops a vacuum from moving rows out from under the postings.

#===----------------------------------------------------------------------===#
# 1. an UPDATE below the mark is missed without an ART index
#===----------------------------------------------------------------------===#

statement ok
CREATE TABLE bare(id INTEGER, s VARCHAR);

statement ok
INSERT INTO bare SELECT i, 'row ' || i || ' filler' FROM range(2000) t(i);

statement ok
PRAGMA create_ngram_index('bare', 's');

statement ok
UPDATE bare SET s = 'zqx sentinel alpha' WHERE id = 100;

# the row did not move, so the index still holds the postings of the old value
query I
SELECT rowid FROM bare WHERE id = 100;
----
100

query I
SELECT count(*) FROM bare WHERE s LIKE '%zqx sentinel alpha%';
----
1

# the documented gap: a real row the index cannot produce
query I
SELECT count(*) FROM ngram_search('bare', 'zqx sentinel alpha');
----
0

#===----------------------------------------------------------------------===#
# 2. an ART index on the same column converts the UPDATE, closing the gap
#===----------------------------------------------------------------------===#

statement ok
CREATE TABLE arted(id INTEGER, s VARCHAR);

statement ok
INSERT INTO arted SELECT i, 'row ' || i || ' filler' FROM range(2000) t(i);

statement ok
CREATE INDEX arted_s_idx ON arted(s);

statement ok
PRAGMA create_ngram_index('arted', 's');

statement ok
UPDATE arted SET s = 'zqx sentinel beta' WHERE id = 100;

# delete + insert: the row is re-appended past the mark of 1999
query I
SELECT rowid FROM arted WHERE id = 100;
----
2000

# the tail scan covers it before any refresh runs
query I
SELECT count(*) FROM ngram_search('arted', 'zqx sentinel beta');
----
1

statement ok
PRAGMA ngram_refresh('arted');

# refresh put the re-appended rowid in the postings, so the answer no longer
# depends on the tail
query I
SELECT count(DISTINCT rid) FROM (
	SELECT unnest(ngram_decode_postings(postings)) rid FROM ngram_main_arted.segments_s
) WHERE rid = 2000;
----
1

query I
SELECT count(*) FROM ngram_search('arted', 'zqx sentinel beta');
----
1

# the value it replaced is gone from the answers, not merely outvoted
query I
SELECT count(*) FROM ngram_search('arted', 'row 100 filler');
----
0

#===----------------------------------------------------------------------===#
# 3. the column sets have to intersect: a key on another column does nothing
#===----------------------------------------------------------------------===#

statement ok
CREATE TABLE pked(id INTEGER PRIMARY KEY, s VARCHAR);

statement ok
INSERT INTO pked SELECT i, 'row ' || i || ' filler' FROM range(2000) t(i);

statement ok
PRAGMA create_ngram_index('pked', 's');

statement ok
UPDATE pked SET s = 'zqx sentinel gamma' WHERE id = 100;

query I
SELECT rowid FROM pked WHERE id = 100;
----
100

query I
SELECT count(*) FROM ngram_search('pked', 'zqx sentinel gamma');
----
0

#===----------------------------------------------------------------------===#
# 4. vacuum relocates rowids only when no ART index exists
#===----------------------------------------------------------------------===#

# one whole row group (122880 rows) is deleted, then a full checkpoint. Without
# an index DuckDB drops the empty row group and pulls every later rowid down.

statement ok
CREATE TABLE vac_bare(id INTEGER, s VARCHAR);

statement ok
INSERT INTO vac_bare SELECT i, 'row ' || i || ' filler' FROM range(200000) t(i);

statement ok
PRAGMA create_ngram_index('vac_bare', 's');

statement ok
DELETE FROM vac_bare WHERE id < 122880;

statement ok
CHECKPOINT;

query I
SELECT min(rowid) FROM vac_bare;
----
0

# on its own this is the detected branch: the table is now shorter than the
# mark, which is proof enough to refuse without reading a single row
statement error
SELECT count(*) FROM ngram_search('vac_bare', 'row 150000 filler');
----
the table now holds 77120 committed rowids but the index covers rowids up to 199999

# appending past the mark removes that proof, and the same query then answers
# short instead of refusing — the state Option D exists to prevent
statement ok
INSERT INTO vac_bare SELECT i, 'row ' || i || ' filler' FROM range(200000, 350000) t(i);

query I
SELECT count(*) FROM vac_bare WHERE s LIKE '%row 150000 filler%';
----
1

query I
SELECT count(*) FROM ngram_search('vac_bare', 'row 150000 filler');
----
0

statement ok
CREATE TABLE vac_arted(id INTEGER, s VARCHAR);

statement ok
INSERT INTO vac_arted SELECT i, 'row ' || i || ' filler' FROM range(200000) t(i);

statement ok
CREATE INDEX vac_arted_s_idx ON vac_arted(s);

statement ok
PRAGMA create_ngram_index('vac_arted', 's');

statement ok
DELETE FROM vac_arted WHERE id < 122880;

statement ok
CHECKPOINT;

# the surviving rows kept their rowids, so the postings still describe them
query I
SELECT min(rowid) FROM vac_arted;
----
122880

query I
SELECT count(*) FROM ngram_search('vac_arted', 'row 150000 filler');
----
1
