# name: test/sql/build_scale.test
# description: index build at scale: segment boundaries, differential identity, memory-limited smoke
# group: [sql]

require ngram

# 1.15M rows crosses the rowid >> 20 segment boundary (2^20 = 1048576), so the
# build must produce more than one segment_no
statement ok
CREATE TABLE big AS SELECT i::VARCHAR AS s FROM range(1150000) t(i);

statement ok
PRAGMA create_ngram_index('big', 's');

statement ok
SET VARIABLE big_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                           FROM __ngram.registry WHERE table_name = 'big');

# the index is exactly the brute-force extraction (both directions)
query I
SELECT count(*) FROM (
	(SELECT gram, unnest(ngram_decode_postings(postings)) rid
	 FROM query('SELECT * FROM ' || getvariable('big_schema') || '.segments')
	 EXCEPT SELECT DISTINCT unnest(trigrams(s)) gram, rowid FROM big WHERE s IS NOT NULL)
	UNION ALL
	(SELECT DISTINCT unnest(trigrams(s)) gram, rowid FROM big WHERE s IS NOT NULL
	 EXCEPT SELECT gram, unnest(ngram_decode_postings(postings)) rid
	 FROM query('SELECT * FROM ' || getvariable('big_schema') || '.segments'))
);
----
0

# rowids 0..1149999 span exactly two rowid >> 20 buckets
query I
SELECT count(DISTINCT segment_no) FROM query('SELECT * FROM ' || getvariable('big_schema') || '.segments');
----
2

# stats totals agree with the segments table
query I
SELECT (SELECT sum(row_count) FROM query('SELECT * FROM ' || getvariable('big_schema') || '.stats')) =
       (SELECT sum(rowid_count) FROM query('SELECT * FROM ' || getvariable('big_schema') || '.segments'))
   AND (SELECT count(*) FROM query('SELECT * FROM ' || getvariable('big_schema') || '.stats')) =
       (SELECT count(DISTINCT gram) FROM query('SELECT * FROM ' || getvariable('big_schema') || '.segments'))
   AND (SELECT sum(segment_count) FROM query('SELECT * FROM ' || getvariable('big_schema') || '.stats')) =
       (SELECT count(*) FROM query('SELECT * FROM ' || getvariable('big_schema') || '.segments'));
----
true

# hwm covers all rows
query I
SELECT hwm_rowid = (SELECT max(rowid) FROM big)
FROM query('SELECT * FROM ' || getvariable('big_schema') || '.meta');
----
true

statement ok
PRAGMA drop_ngram_index('big', 's');

#===----------------------------------------------------------------------===#
# Partitioning changes nothing about the index
#
# The build feeds the packing aggregate one rowid-range partition at a time so
# its states fit the memory limit. Partitions are cut on segment boundaries, so
# every (gram, segment_no) is grouped inside exactly one of them and the
# segment rows must come out identical however many there are — and identical
# on one thread, which is the crash-harness and CI-runner configuration.
#===----------------------------------------------------------------------===#

# 3 * 2^20 rows: three segments, so a partition count above one has real
# boundaries to cut on
statement ok
CREATE TABLE parts AS SELECT i::VARCHAR AS s FROM range(3145728) t(i);

statement ok
SET ngram_build_partitions = 1;

statement ok
PRAGMA create_ngram_index('parts', 's');

statement ok
SET VARIABLE parts_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                             FROM __ngram.registry WHERE table_name = 'parts');

statement ok
CREATE TABLE snapshot_one AS FROM query('SELECT * FROM ' || getvariable('parts_schema') || '.segments');

query I
SELECT count(DISTINCT segment_no) FROM snapshot_one;
----
3

statement ok
PRAGMA drop_ngram_index('parts', 's');

statement ok
SET ngram_build_partitions = 3;

statement ok
PRAGMA create_ngram_index('parts', 's');

statement ok
SET VARIABLE parts_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                             FROM __ngram.registry WHERE table_name = 'parts');

statement ok
CREATE TABLE snapshot_three AS FROM query('SELECT * FROM ' || getvariable('parts_schema') || '.segments');

# every column of every segment row, both directions: three partitions produce
# the same bytes as one
query I
SELECT count(*) FROM (
	(SELECT * FROM snapshot_one EXCEPT SELECT * FROM snapshot_three)
	UNION ALL
	(SELECT * FROM snapshot_three EXCEPT SELECT * FROM snapshot_one));
----
0

# one row per key, not one per partition
query I
SELECT count(*) = count(DISTINCT (gram, segment_no)) FROM snapshot_three;
----
true

# the segments table is written in gram order whatever the partitioning: that
# is what lets the probe's `gram = ?` filter skip row groups by zone map
query I
SELECT count(*) FROM (
	SELECT gram < lag(gram) OVER (ORDER BY rowid) AS out_of_order
	FROM query('SELECT gram, rowid FROM ' || getvariable('parts_schema') || '.segments'))
WHERE out_of_order;
----
0

statement ok
PRAGMA drop_ngram_index('parts', 's');

statement ok
SET threads = 1;

statement ok
PRAGMA create_ngram_index('parts', 's');

statement ok
SET VARIABLE parts_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                             FROM __ngram.registry WHERE table_name = 'parts');

query I
SELECT count(*) FROM (
	(SELECT * FROM snapshot_one EXCEPT
	 SELECT * FROM query('SELECT * FROM ' || getvariable('parts_schema') || '.segments'))
	UNION ALL
	(SELECT * FROM query('SELECT * FROM ' || getvariable('parts_schema') || '.segments')
	 EXCEPT SELECT * FROM snapshot_one));
----
0

statement ok
RESET threads

statement ok
RESET ngram_build_partitions

statement ok
PRAGMA drop_ngram_index('parts', 's')

statement ok
DROP TABLE parts

statement ok
DROP TABLE snapshot_one

statement ok
DROP TABLE snapshot_three

# a negative partition count is refused rather than silently treated as auto
statement ok
CREATE TABLE neg AS SELECT 'abc' AS s

statement ok
SET ngram_build_partitions = -1

statement error
PRAGMA create_ngram_index('neg', 's');
----
cannot be negative

statement ok
RESET ngram_build_partitions

statement ok
DROP TABLE neg

# memory-limited build smoke: cap threads along with memory (each test file
# runs in its own database, but RESET below restores this connection for later
# blocks)
statement ok
SET threads = 4;

statement ok
SET memory_limit = '300MB';

statement ok
CREATE TABLE mem_corpus AS SELECT md5(i::VARCHAR) AS s FROM range(200000) t(i);

statement ok
PRAGMA create_ngram_index('mem_corpus', 's');

statement ok
SET VARIABLE mem_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                           FROM __ngram.registry WHERE table_name = 'mem_corpus');

query I
SELECT count(*) > 0 FROM query('SELECT * FROM ' || getvariable('mem_schema') || '.stats');
----
true

query I
SELECT hwm_rowid = (SELECT max(rowid) FROM mem_corpus)
FROM query('SELECT * FROM ' || getvariable('mem_schema') || '.meta');
----
true

statement ok
RESET memory_limit;

statement ok
RESET threads;
