# name: test/sql/index_persistence.test
# description: ngram index survives database close/reopen
# group: [sql]

load __TEST_DIR__/ngram_persistence.db

require ngram

statement ok
CREATE TABLE docs(s VARCHAR);

statement ok
INSERT INTO docs VALUES ('Hello world'), ('hello DUCK'), (NULL), ('connection reset by peer');

statement ok
PRAGMA create_ngram_index('docs', 's');

query IIIIIIIIIIIII
PRAGMA ngram_index_stats('docs');
----
s	3	true	3	3	0	35	35	0	1	39	109	NULL

restart

statement ok
SET VARIABLE idx_id = (SELECT replace(index_id::VARCHAR, '-', '')
                           FROM __ngram.registry WHERE table_name = 'docs' AND column_name = 's');

# the reopened index is identical to a brute-force re-extraction
query I
SELECT count(*) FROM (
	(SELECT gram_key, unnest(ngram_decode_postings(postings)) rid
	 FROM query('SELECT * FROM __ngram.segments_' || getvariable('idx_id'))
	 EXCEPT SELECT DISTINCT ngram_gram_key(unnest(trigrams(s))) gram_key, rowid FROM docs WHERE s IS NOT NULL)
	UNION ALL
	(SELECT DISTINCT ngram_gram_key(unnest(trigrams(s))) gram_key, rowid FROM docs WHERE s IS NOT NULL
	 EXCEPT SELECT gram_key, unnest(ngram_decode_postings(postings)) rid
	 FROM query('SELECT * FROM __ngram.segments_' || getvariable('idx_id')))
);
----
0

query IIIIIIIIIIIII
PRAGMA ngram_index_stats('docs');
----
s	3	true	3	3	0	35	35	0	1	39	109	NULL

# the base table stays fully usable alongside the index
statement ok
INSERT INTO docs VALUES ('post-restart row');

query I
SELECT count(*) FROM docs;
----
5

statement ok
PRAGMA drop_ngram_index('docs', 's');

restart

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = '__ngram' AND table_name <> 'registry';
----
0

# An index this host wrote reopens READY with a persisted tail: rows appended
# after the build sit past the high-water mark, both paths probe the index and
# match a scan across them, and a refresh advances the mark exactly.
statement ok
CREATE TABLE tail_docs(id INTEGER, s VARCHAR);

statement ok
INSERT INTO tail_docs VALUES (0, 'alpha'), (1, 'Tent pole'), (2, 'CONTENT'), (3, 'beta'), (4, 'gamma');

statement ok
PRAGMA create_ngram_index('tail_docs', 's');

statement ok
INSERT INTO tail_docs VALUES (5, 'extent'), (6, 'tentative');

restart

query TTTTTITT
PRAGMA ngram_indexes;
----
ngram_persistence	<REGEX>:[0-9a-f-]{36}	main	tail_docs	s	5	READY	NULL

query I
SELECT hwm_rowid FROM __ngram.registry WHERE table_name = 'tail_docs';
----
4

# Four of seven rows match, so both paths need the whole candidate fraction.
statement ok
SET ngram_max_candidate_fraction = 1;

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT count(*) FROM ngram_search('tail_docs', 'tent');
----
analyzed_plan	<REGEX>:.*"Ngram Mode": "index .*

query I
SELECT id FROM ngram_search('tail_docs', 'tent') ORDER BY id;
----
1
2
5
6

statement ok
SET ngram_auto_accelerate = true;

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT count(*) FROM tail_docs WHERE s ILIKE '%tent%';
----
analyzed_plan	<REGEX>:.*"Ngram Mode": "index .*

query I
SELECT id FROM tail_docs WHERE s ILIKE '%tent%' ORDER BY id;
----
1
2
5
6

statement ok
SET ngram_auto_accelerate = false;

statement ok
RESET ngram_max_candidate_fraction;

statement ok
PRAGMA ngram_refresh('tail_docs');

query I
SELECT hwm_rowid FROM __ngram.registry WHERE table_name = 'tail_docs';
----
6

query I
SELECT id FROM ngram_search('tail_docs', 'tent') ORDER BY id;
----
1
2
5
6
