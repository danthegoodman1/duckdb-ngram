# name: test/sql/postings_codec.test
# description: postings blob codec round-trips
# group: [sql]

require ngram

query I
SELECT ngram_decode_postings(ngram_encode_postings([1, 5, 9]::BIGINT[]));
----
[1, 5, 9]

# encode sorts and deduplicates
query I
SELECT ngram_decode_postings(ngram_encode_postings([5, 1, 5, 9, 1]::BIGINT[]));
----
[1, 5, 9]

query I
SELECT ngram_decode_postings(ngram_encode_postings([]::BIGINT[]));
----
[]

query I
SELECT ngram_decode_postings(ngram_encode_postings([0]::BIGINT[]));
----
[0]

# large values survive the varint encoding
query I
SELECT ngram_decode_postings(ngram_encode_postings([0, 127, 128, 16383, 16384, 4611686018427387904]::BIGINT[]));
----
[0, 127, 128, 16383, 16384, 4611686018427387904]

query I
SELECT ngram_encode_postings(NULL);
----
NULL

query I
SELECT ngram_decode_postings(NULL);
----
NULL

statement error
SELECT ngram_encode_postings([-1]::BIGINT[]);
----
negative

statement error
SELECT ngram_encode_postings([1, NULL]::BIGINT[]);
----
NULL

query I
SELECT ngram_decode_postings(ngram_encode_postings([9223372036854775807]::BIGINT[]));
----
[9223372036854775807]

statement error
SELECT ngram_decode_postings('garbage'::BLOB);
----
postings blob

# a varint whose 10th byte carries bits beyond 2^63 would wrap to a negative
# rowid ([-1] before hardening)
statement error
SELECT ngram_decode_postings('\x01\x01\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\x7F'::BLOB);
----
malformed postings blob

# a varint encoding exactly 2^63 exceeds INT64_MAX (INT64_MIN before hardening)
statement error
SELECT ngram_decode_postings('\x01\x01\x80\x80\x80\x80\x80\x80\x80\x80\x80\x01'::BLOB);
----
malformed postings blob

# a zero delta after the first entry cannot come from sorted unique rowids
statement error
SELECT ngram_decode_postings('\x01\x02\x05\x00'::BLOB);
----
malformed postings blob

# deltas summing past INT64_MAX would wrap negative
statement error
SELECT ngram_decode_postings('\x01\x02\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\x7F\x01'::BLOB);
----
malformed postings blob

# randomized round-trip: decode(encode(l)) must equal the sorted unique list
statement ok
CREATE TABLE codec_fuzz AS
SELECT list((random() * 1e15)::BIGINT) AS l
FROM range(10000) t(i)
GROUP BY i % 97;

query I
SELECT count(*)
FROM codec_fuzz
WHERE ngram_decode_postings(ngram_encode_postings(l)) != list_sort(list_distinct(l));
----
0
