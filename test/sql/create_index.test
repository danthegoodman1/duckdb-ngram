# name: test/sql/create_index.test
# description: create_ngram_index / drop_ngram_index / ngram_index_stats lifecycle
# group: [sql]

require ngram

statement ok
CREATE TABLE docs(id INTEGER, s VARCHAR, n INTEGER);

statement ok
INSERT INTO docs VALUES
	(1, 'Hello world', 10),
	(2, 'hello DUCK', 20),
	(3, NULL, 30),
	(4, 'ab', 40),
	(5, 'connection reset by peer', 50),
	(6, 'öft ÖFT often', 60);

statement ok
PRAGMA create_ngram_index('docs', 's');

# shadow tables exist
query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'ngram_main_docs';
----
3

# options round-trip through the meta table
query IIIIII
SELECT format_version, schema_name, table_name, column_name, gram_size, case_insensitive
FROM ngram_main_docs.meta_s;
----
1	main	docs	s	3	true

# hwm covers all rows at build time
query I
SELECT hwm_rowid = (SELECT max(rowid) FROM docs) FROM ngram_main_docs.meta_s;
----
true

# the index is exactly the brute-force extraction (both directions)
query I
SELECT count(*) FROM (
	(SELECT gram, unnest(ngram_decode_postings(postings)) rid FROM ngram_main_docs.segments_s
	 EXCEPT SELECT DISTINCT unnest(trigrams(s)) gram, rowid FROM docs WHERE s IS NOT NULL)
	UNION ALL
	(SELECT DISTINCT unnest(trigrams(s)) gram, rowid FROM docs WHERE s IS NOT NULL
	 EXCEPT SELECT gram, unnest(ngram_decode_postings(postings)) rid FROM ngram_main_docs.segments_s)
);
----
0

# stats agree with the segments table
query I
SELECT count(*) FROM ngram_main_docs.stats_s;
----
44

query II
SELECT row_count, segment_count FROM ngram_main_docs.stats_s WHERE gram = 'hel';
----
2	1

# duplicate create errors
statement error
PRAGMA create_ngram_index('docs', 's');
----
already exists

# missing table / missing column / wrong type errors
statement error
PRAGMA create_ngram_index('nope', 's');
----
does not exist

statement error
PRAGMA create_ngram_index('docs', 'nope');
----
does not have a column

statement error
PRAGMA create_ngram_index('docs', 'n');
----
VARCHAR

statement error
PRAGMA create_ngram_index('docs', 's', gram = 0);
----
at least 1

# stats on an unindexed table errors
statement error
PRAGMA ngram_index_stats('unindexed');
----
does not exist

statement ok
CREATE TABLE unindexed(s VARCHAR);

statement error
PRAGMA ngram_index_stats('unindexed');
----
No ngram indexes

# a second indexed column on the same table shares the shadow schema
statement ok
ALTER TABLE docs ADD COLUMN t VARCHAR;

statement ok
UPDATE docs SET t = 'tent often entered';

statement ok
PRAGMA create_ngram_index('docs', 't', gram = 2, case_insensitive = false);

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'ngram_main_docs';
----
6

query IIIIIIII
PRAGMA ngram_index_stats('docs');
----
s	3	true	5	44	44	48	136
t	2	false	5	12	12	72	96

# dropping one column's index leaves the other intact
statement ok
PRAGMA drop_ngram_index('docs', 's');

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'ngram_main_docs';
----
3

query IIIIIIII
PRAGMA ngram_index_stats('docs');
----
t	2	false	5	12	12	72	96

# dropping the last index removes the shadow schema
statement ok
PRAGMA drop_ngram_index('docs', 't');

query I
SELECT count(*) FROM duckdb_schemas() WHERE schema_name = 'ngram_main_docs';
----
0

statement error
PRAGMA drop_ngram_index('docs', 's');
----
No ngram index

# index build on an empty table works and yields empty postings
statement ok
CREATE TABLE empty_docs(s VARCHAR);

statement ok
PRAGMA create_ngram_index('empty_docs', 's');

query IIII
SELECT hwm_rowid, (SELECT count(*) FROM ngram_main_empty_docs.segments_s),
       (SELECT count(*) FROM ngram_main_empty_docs.stats_s), gram_size
FROM ngram_main_empty_docs.meta_s;
----
-1	0	0	3

# NULL named parameters error instead of hitting an internal error
statement error
PRAGMA create_ngram_index('docs', 's', gram = NULL);
----
cannot be NULL

statement error
PRAGMA create_ngram_index('docs', 's', case_insensitive = NULL);
----
cannot be NULL

# a view is not an indexable target
statement ok
CREATE VIEW docs_view AS SELECT s FROM docs;

statement error
PRAGMA create_ngram_index('docs_view', 's');
----
view, not a table

# temporary tables are rejected up front
statement ok
CREATE TEMP TABLE temp_docs(s VARCHAR);

statement error
PRAGMA create_ngram_index('temp_docs', 's');
----
temporary

# a user column named rowid (any case) shadows the row-identifier pseudo-column,
# so the build would silently index that column's values; refuse instead
statement ok
CREATE TABLE has_rowid("RowID" BIGINT, s VARCHAR);

statement error
PRAGMA create_ngram_index('has_rowid', 's');
----
shadows the rowid pseudo-column

# evil identifiers: keyword column name, dotted table name, unicode column name
statement ok
CREATE TABLE "my.table"("select" VARCHAR, "sträße" VARCHAR);

statement ok
INSERT INTO "my.table" VALUES ('hello world', 'guten tag');

statement ok
PRAGMA create_ngram_index('"my.table"', 'select');

statement ok
PRAGMA create_ngram_index('"my.table"', 'sträße');

query IIIIIIII
PRAGMA ngram_index_stats('"my.table"');
----
select	3	true	0	9	9	9	27
sträße	3	true	0	7	7	7	21

statement ok
PRAGMA drop_ngram_index('"my.table"', 'select');

statement ok
PRAGMA drop_ngram_index('"my.table"', 'sträße');

query I
SELECT count(*) FROM duckdb_schemas() WHERE schema_name = 'ngram_main_my.table';
----
0

# shadow schema name collision: (schema a, table b_c) and (schema a_b, table c)
# both map to ngram_a_b_c; the second create must fail loudly, and neither drop
# nor stats may operate through the colliding schema
statement ok
CREATE SCHEMA a;

statement ok
CREATE TABLE a.b_c(s VARCHAR);

statement ok
INSERT INTO a.b_c VALUES ('hello world');

statement ok
CREATE SCHEMA a_b;

statement ok
CREATE TABLE a_b.c(s VARCHAR);

statement ok
INSERT INTO a_b.c VALUES ('goodbye');

statement ok
PRAGMA create_ngram_index('a.b_c', 's');

statement error
PRAGMA create_ngram_index('a_b.c', 's');
----
shadow schema collision

statement error
PRAGMA drop_ngram_index('a_b.c', 's');
----
shadow schema collision

# stats through the colliding name reports nothing rather than the foreign index
query IIIIIIII
PRAGMA ngram_index_stats('a_b.c');
----

# the failed create and refused drop left the owner's index untouched
query IIIIIIII
PRAGMA ngram_index_stats('a.b_c');
----
s	3	true	0	9	9	9	27

# once the owner drops its index, the schema name is free for the other table
statement ok
PRAGMA drop_ngram_index('a.b_c', 's');

statement ok
PRAGMA create_ngram_index('a_b.c', 's');

query II
SELECT schema_name, table_name FROM ngram_a_b_c.meta_s;
----
a_b	c

statement ok
PRAGMA drop_ngram_index('a_b.c', 's');
