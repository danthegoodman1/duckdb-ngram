# name: test/sql/ngram_maintenance.test
# description: PRAGMA ngram_refresh / ngram_compact and the staleness detectors
# group: [sql]

require ngram

statement ok
CREATE TABLE docs(id INTEGER, s VARCHAR);

statement ok
INSERT INTO docs VALUES (1, 'a tent pitched'), (2, 'no match'), (3, 'ten cents');

statement ok
PRAGMA create_ngram_index('docs', 's');

statement ok
SET VARIABLE docs_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                            FROM __ngram.registry WHERE table_name='docs' AND column_name='s');

#===----------------------------------------------------------------------===#
# refresh indexes the tail
#===----------------------------------------------------------------------===#

statement ok
INSERT INTO docs VALUES (4, 'tent number two'), (5, NULL), (6, 'ab'), (7, 'yet another tent');

# before the refresh the tail rows are found by the brute-force tail scan, so
# the index itself does not know them: they are not candidates
query I
SELECT count(*) FROM ngram_candidates('docs', 's', 'tent') WHERE rowid > 2;
----
0

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
1
4
7

statement ok
PRAGMA ngram_refresh('docs');

# after the refresh the same rows come out of the index, and the high-water
# mark covers the whole table (including the NULL and the too-short row)
query I
SELECT count(*) FROM ngram_candidates('docs', 's', 'tent') WHERE rowid > 2;
----
2

query I
SELECT hwm_rowid = (SELECT max(rowid) FROM docs)
FROM query('SELECT * FROM ' || getvariable('docs_schema') || '.meta');
----
true

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
1
4
7

# the refresh appended a generation rather than rewriting the index
query I
SELECT count(DISTINCT generation)
FROM query('SELECT * FROM ' || getvariable('docs_schema') || '.segments');
----
2

# a refresh with nothing past the mark is a no-op: same mark, same segments
statement ok
PRAGMA ngram_refresh('docs');

query II
SELECT (SELECT hwm_rowid FROM query('SELECT * FROM ' || getvariable('docs_schema') || '.meta')),
       (SELECT count(*) FROM query('SELECT * FROM ' || getvariable('docs_schema') || '.segments'));
----
6	45

# refresh after a DELETE that was not vacuumed is allowed: deleting rows leaves
# every surviving rowid where it was, and recheck already hides the dead
# postings. Raise the harness's zero checkpoint threshold so this block pins
# the un-vacuumed-delete refresh path separately; the rowid guard makes a later
# checkpoint non-moving.
statement ok
SET checkpoint_threshold = '1GB';

statement ok
DELETE FROM docs WHERE id = 3;

statement ok
INSERT INTO docs VALUES (8, 'tent after delete');

statement ok
PRAGMA ngram_refresh('docs');

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
1
4
7
8

#===----------------------------------------------------------------------===#
# compaction
#===----------------------------------------------------------------------===#

query I
SELECT count(*) > 0 FROM (SELECT gram, segment_no FROM
	query('SELECT * FROM ' || getvariable('docs_schema') || '.segments')
	GROUP BY gram, segment_no HAVING count(*) > 1);
----
true

statement ok
PRAGMA ngram_compact('docs');

# every (gram, segment_no) is one row again
query I
SELECT count(*) FROM (SELECT gram, segment_no FROM
	query('SELECT * FROM ' || getvariable('docs_schema') || '.segments')
	GROUP BY gram, segment_no HAVING count(*) > 1);
----
0

# stats hold one row per gram, matching the merged segments
query I
SELECT count(*) FROM (SELECT gram FROM query('SELECT * FROM ' || getvariable('docs_schema') || '.stats')
	GROUP BY gram HAVING count(*) > 1);
----
0

query I
SELECT count(*) FROM (
	(SELECT gram, row_count FROM query('SELECT * FROM ' || getvariable('docs_schema') || '.stats')
	 EXCEPT SELECT gram, sum(rowid_count)::BIGINT
	 FROM query('SELECT * FROM ' || getvariable('docs_schema') || '.segments') GROUP BY gram)
	UNION ALL
	(SELECT gram, sum(rowid_count)::BIGINT
	 FROM query('SELECT * FROM ' || getvariable('docs_schema') || '.segments') GROUP BY gram
	 EXCEPT SELECT gram, row_count FROM query('SELECT * FROM ' || getvariable('docs_schema') || '.stats'))
);
----
0

# Exact results are unchanged by merge-only compaction. It deliberately does
# not read the base table, so the dead posting remains a lossy candidate until
# an explicit purging compaction.
query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
1
4
7
8

query I
SELECT count(*) FROM ngram_candidates('docs', 's', 'ten') WHERE rowid = 2;
----
1

# compaction is idempotent: a second run finds nothing to merge and changes
# neither the segment rows nor the answers
statement ok
PRAGMA ngram_compact('docs');

query I
SELECT count(*) FROM (SELECT gram, segment_no FROM
	query('SELECT * FROM ' || getvariable('docs_schema') || '.segments')
	GROUP BY gram, segment_no HAVING count(*) > 1);
----
0

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
1
4
7
8

# purge := true rewrites every key, so dead postings are dropped everywhere and
# not only where the merge happened to rewrite the blob
statement ok
DELETE FROM docs WHERE id = 1;

query I
SELECT count(*) FROM ngram_candidates('docs', 's', 'tent') WHERE rowid = 0;
----
1

statement ok
PRAGMA ngram_compact('docs', purge = true);

query I
SELECT count(*) FROM ngram_candidates('docs', 's', 'tent') WHERE rowid = 0;
----
0

query I
SELECT count(*) FROM ngram_candidates('docs', 's', 'ten') WHERE rowid = 2;
----
0

query I
SELECT id FROM ngram_search('docs', 'tent') ORDER BY id;
----
4
7
8

# Purge may retain only non-NULL indexed rows in its one-pass live-rowid temp:
# build/refresh never create NULL postings, indexed updates are delete+append
# under the v3 guard, and an unrelated-column update preserves rowid.
statement ok
CREATE TABLE purge_nulls(id INTEGER, note INTEGER, s VARCHAR);

statement ok
INSERT INTO purge_nulls VALUES (1, 10, 'old needle'), (2, 20, NULL), (3, 30, 'keep needle');

statement ok
PRAGMA create_ngram_index('purge_nulls', 's');

statement ok
UPDATE purge_nulls SET s = NULL WHERE id = 1;

statement ok
UPDATE purge_nulls SET s = 'new needle' WHERE id = 2;

statement ok
UPDATE purge_nulls SET note = 31 WHERE id = 3;

statement ok
PRAGMA ngram_refresh('purge_nulls');

query III
SELECT (SELECT count(*) FROM ngram_candidates('purge_nulls', 's', 'old')),
       (SELECT count(*) FROM ngram_candidates('purge_nulls', 's', 'new')),
       (SELECT count(*) FROM ngram_candidates('purge_nulls', 's', 'keep'));
----
1	1	1

statement ok
BEGIN;

statement ok
PRAGMA ngram_compact('purge_nulls', purge = true);

query III
SELECT (SELECT count(*) FROM ngram_candidates('purge_nulls', 's', 'old')),
       (SELECT count(*) FROM ngram_candidates('purge_nulls', 's', 'new')),
       (SELECT count(*) FROM ngram_candidates('purge_nulls', 's', 'keep'));
----
0	1	1

statement ok
ROLLBACK;

query III
SELECT (SELECT count(*) FROM ngram_candidates('purge_nulls', 's', 'old')),
       (SELECT count(*) FROM ngram_candidates('purge_nulls', 's', 'new')),
       (SELECT count(*) FROM ngram_search('purge_nulls', 'keep'));
----
1	1	1

statement ok
PRAGMA ngram_compact('purge_nulls', purge = true);

query III
SELECT (SELECT count(*) FROM ngram_candidates('purge_nulls', 's', 'old')),
       (SELECT count(*) FROM ngram_candidates('purge_nulls', 's', 'new')),
       (SELECT note FROM ngram_search('purge_nulls', 'keep'));
----
0	1	31

# a full differential check over the compacted index
query I
SELECT count(*) FROM (
	(SELECT * FROM ngram_search('docs', 'ten') EXCEPT SELECT * FROM docs WHERE contains(lower(s), 'ten'))
	UNION ALL
	(SELECT * FROM docs WHERE contains(lower(s), 'ten') EXCEPT SELECT * FROM ngram_search('docs', 'ten'))
);
----
0

# SQLLogic query() cannot issue DDL/DML against a runtime UUID schema. The C++
# lifecycle harness retains the complete NULL/key/blob/descriptor corruption
# matrix and the atomic refresh/compaction state assertions above.

query I
SELECT count(*) FROM duckdb_tables()
WHERE database_name = 'temp' AND table_name LIKE '__ngram_%';
----
0

# Binary grouping/order must not inherit the session collation. Case-distinct
# grams remain distinct on a case-sensitive index, and a three-codepoint UTF-8
# gram remains valid through both compaction modes.
statement ok
SET default_collation = 'nocase';

statement ok
SET threads = 4;

statement ok
SET preserve_insertion_order = false;

statement ok
CREATE TABLE compact_collation(id INTEGER, s VARCHAR);

statement ok
INSERT INTO compact_collation VALUES (1, 'Aaa'), (2, 'aaa'), (3, 'é日🙂x');

statement ok
PRAGMA create_ngram_index('compact_collation', 's', case_insensitive = false);

statement ok
SET VARIABLE collation_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                                 FROM __ngram.registry
                                 WHERE table_name='compact_collation' AND column_name='s');

query II
SELECT count(*) FILTER (WHERE encode(gram) = encode('Aaa')),
       count(*) FILTER (WHERE encode(gram) = encode('aaa'))
FROM query('SELECT * FROM ' || getvariable('collation_schema') || '.stats');
----
1	1

query I
SELECT count(*) FROM (
	SELECT encode(gram) < lag(encode(gram)) OVER (ORDER BY rowid) AS out_of_order
	FROM query('SELECT gram,rowid FROM ' || getvariable('collation_schema') || '.stats'))
WHERE out_of_order;
----
0

statement ok
INSERT INTO compact_collation VALUES (4, 'Aaa'), (5, 'aaa'), (6, 'é日🙂y');

statement ok
PRAGMA ngram_refresh('compact_collation');

# Refresh folds stats history immediately, retaining byte-distinct grams and
# binary physical order before compaction folds the segment generation.
query II
SELECT count(*) FILTER (WHERE encode(gram) = encode('Aaa')),
       count(*) FILTER (WHERE encode(gram) = encode('aaa'))
FROM query('SELECT * FROM ' || getvariable('collation_schema') || '.stats');
----
1	1

query I
SELECT count(*) FROM (
	SELECT encode(gram) < lag(encode(gram)) OVER (ORDER BY rowid) AS out_of_order
	FROM query('SELECT gram,rowid FROM ' || getvariable('collation_schema') || '.stats'))
WHERE out_of_order;
----
0

query I
SELECT count(*) FROM (
	SELECT encode(gram) < lag(encode(gram)) OVER (PARTITION BY generation ORDER BY rowid) AS out_of_order
	FROM query('SELECT gram,generation,rowid FROM ' || getvariable('collation_schema') || '.segments'))
WHERE out_of_order;
----
0

statement ok
PRAGMA ngram_compact('compact_collation');

statement ok
PRAGMA ngram_compact('compact_collation', purge = true);

query III
SELECT (SELECT count(*) FROM ngram_search('compact_collation', 'Aaa')),
       (SELECT count(*) FROM ngram_search('compact_collation', 'aaa')),
       (SELECT count(*) FROM ngram_search('compact_collation', 'é日🙂'));
----
2	2	2

query II
SELECT row_count, segment_count FROM query('SELECT * FROM ' || getvariable('collation_schema') || '.stats')
WHERE encode(gram) = encode('Aaa');
----
2	1

query II
SELECT count(*) FILTER (WHERE encode(gram) = encode('Aaa')),
       count(*) FILTER (WHERE encode(gram) = encode('aaa'))
FROM query('SELECT * FROM ' || getvariable('collation_schema') || '.segments');
----
1	1

query I
SELECT count(*) FROM (
	SELECT encode(gram) < lag(encode(gram)) OVER (ORDER BY rowid) AS out_of_order
	FROM query('SELECT gram,rowid FROM ' || getvariable('collation_schema') || '.stats'))
WHERE out_of_order;
----
0

query I
SELECT count(*) FROM (
	SELECT encode(gram) < lag(encode(gram)) OVER (ORDER BY rowid) AS out_of_order
	FROM query('SELECT gram,rowid FROM ' || getvariable('collation_schema') || '.segments'))
WHERE out_of_order;
----
0

statement ok
SET default_collation = 'binary';

statement ok
RESET preserve_insertion_order;

#===----------------------------------------------------------------------===#
# observability: what the stats pragma reports about maintenance state
#===----------------------------------------------------------------------===#

statement ok
INSERT INTO docs VALUES (9, 'tent for the stats');

# hwm behind table_max_rowid is the signal that a refresh has work to do, and
# remaining_tail counts what that refresh would index (one row here, since the
# rowid the deleted row left behind is a gap rather than work);
# fragmented_keys and generations are the signal for compaction. A pragma
# cannot be wrapped in a subquery, so the row is pinned whole.
query IIIIIIIIIIIII
PRAGMA ngram_index_stats('docs');
----
s	3	true	7	8	1	39	39	0	1	48	126	NULL

#===----------------------------------------------------------------------===#
# two indexed columns refresh independently
#===----------------------------------------------------------------------===#

statement ok
CREATE TABLE two(id INTEGER, a VARCHAR, b VARCHAR);

statement ok
INSERT INTO two VALUES (1, 'alpha tent', 'beta tent');

statement ok
PRAGMA create_ngram_index('two', 'a');

statement ok
PRAGMA create_ngram_index('two', 'b');

statement ok
SET VARIABLE two_a_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                             FROM __ngram.registry WHERE table_name='two' AND column_name='a');

statement ok
SET VARIABLE two_b_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                             FROM __ngram.registry WHERE table_name='two' AND column_name='b');

statement ok
INSERT INTO two VALUES (2, 'second tent a', 'second tent b');

statement ok
PRAGMA ngram_refresh('two', col = 'a');

query II
SELECT (SELECT hwm_rowid FROM query('SELECT * FROM ' || getvariable('two_a_schema') || '.meta')),
       (SELECT hwm_rowid FROM query('SELECT * FROM ' || getvariable('two_b_schema') || '.meta'));
----
1	0

query I
SELECT count(*) FROM ngram_candidates('two', 'a', 'second');
----
1

query I
SELECT count(*) FROM ngram_candidates('two', 'b', 'second');
----
0

# the table-wide form advances every index
statement ok
PRAGMA ngram_refresh('two');

query II
SELECT (SELECT hwm_rowid FROM query('SELECT * FROM ' || getvariable('two_a_schema') || '.meta')),
       (SELECT hwm_rowid FROM query('SELECT * FROM ' || getvariable('two_b_schema') || '.meta'));
----
1	1

query I
SELECT count(*) FROM ngram_candidates('two', 'b', 'second');
----
1

statement ok
PRAGMA ngram_compact('two', col = 'b');

statement error
PRAGMA ngram_refresh('two', col = 'nope');
----
no ngram index exists on two.nope

#===----------------------------------------------------------------------===#
# transaction-local rows are never indexed
#
# a local rowid is reassigned at commit, so recording one would leave a posting
# pointing at a rowid that never exists
#===----------------------------------------------------------------------===#

statement ok
CREATE TABLE local_rows(id INTEGER, s VARCHAR);

statement ok
INSERT INTO local_rows VALUES (1, 'committed tent');

statement ok con1
BEGIN;

statement ok con1
INSERT INTO local_rows VALUES (2, 'uncommitted tent');

statement ok con1
PRAGMA create_ngram_index('local_rows', 's');

statement ok con1
SET VARIABLE local_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                             FROM __ngram.registry WHERE table_name='local_rows' AND column_name='s');

# the index stops at the last committed rowid; the uncommitted row is found by
# the tail scan
query I con1
SELECT hwm_rowid FROM query('SELECT * FROM ' || getvariable('local_schema') || '.meta');
----
0

query I con1
SELECT id FROM ngram_search('local_rows', 'tent') ORDER BY id;
----
1
2

statement ok con1
PRAGMA ngram_refresh('local_rows');

query I con1
SELECT hwm_rowid FROM query('SELECT * FROM ' || getvariable('local_schema') || '.meta');
----
0

statement ok con1
COMMIT;

statement ok
SET VARIABLE local_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                             FROM __ngram.registry WHERE table_name='local_rows' AND column_name='s');

# after the commit the row has a real rowid past the mark, and a refresh picks
# it up (before the transaction-local filter this scenario recorded a posting
# for a vanished local rowid and crashed the fetch)
query I
SELECT id FROM ngram_search('local_rows', 'tent') ORDER BY id;
----
1
2

statement ok
PRAGMA ngram_refresh('local_rows');

query II
SELECT (SELECT hwm_rowid FROM query('SELECT * FROM ' || getvariable('local_schema') || '.meta')),
       (SELECT count(*) FROM ngram_candidates('local_rows', 's', 'tent'));
----
1	2

#===----------------------------------------------------------------------===#
# a refresh is one transaction, whoever owns it
#
# The pragma expands to several statements, which the preprocessor wraps in
# BEGIN/COMMIT of its own when there is no user transaction; inside one, the
# statements simply join it. Either way the segment append and the high-water
# mark move together.
#===----------------------------------------------------------------------===#

statement ok
CREATE TABLE atomic(id INTEGER, s VARCHAR);

statement ok
INSERT INTO atomic VALUES (1, 'a tent');

statement ok
PRAGMA create_ngram_index('atomic', 's');

statement ok
SET VARIABLE atomic_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                              FROM __ngram.registry WHERE table_name='atomic' AND column_name='s');

statement ok
INSERT INTO atomic VALUES (2, 'another tent');

statement ok
BEGIN;

statement ok
PRAGMA ngram_refresh('atomic');

query II
SELECT hwm_rowid,
       (SELECT count(*) FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.segments'))
FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.meta');
----
1	14

statement ok
ROLLBACK;

# The execution-time vacuum fence belongs to the rolled-back transaction; a
# following forced checkpoint must not remain blocked by leaked lock state.
statement ok
FORCE CHECKPOINT;

query II
SELECT hwm_rowid,
       (SELECT count(*) FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.segments'))
FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.meta');
----
0	4

statement ok
BEGIN;

statement ok
PRAGMA ngram_refresh('atomic');

statement ok
COMMIT;

query II
SELECT hwm_rowid,
       (SELECT count(*) FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.segments'))
FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.meta');
----
1	14

query I
SELECT count(*) FROM ngram_candidates('atomic', 's', 'tent');
----
2

# Merge-only compaction joins a surrounding transaction and rolls back as one
# unit, including its stats rewrite and scratch tables.
statement ok
CREATE TEMP TABLE phase13_segments_before AS
SELECT * FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.segments');

statement ok
CREATE TEMP TABLE phase13_stats_before AS
SELECT * FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.stats');

statement ok
CREATE TEMP TABLE phase13_meta_before AS
SELECT * FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.meta');

statement ok
BEGIN;

statement ok
PRAGMA ngram_compact('atomic');

query I
SELECT count(*) FROM (SELECT gram, segment_no FROM
	query('SELECT * FROM ' || getvariable('atomic_schema') || '.segments')
	GROUP BY gram, segment_no HAVING count(*) > 1);
----
0

statement ok
ROLLBACK;

query III
SELECT (SELECT count(*) FROM (
	(SELECT * FROM phase13_segments_before EXCEPT
	 SELECT * FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.segments'))
	UNION ALL
	(SELECT * FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.segments')
	 EXCEPT SELECT * FROM phase13_segments_before))),
       (SELECT count(*) FROM (
	(SELECT * FROM phase13_stats_before EXCEPT
	 SELECT * FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.stats'))
	UNION ALL
	(SELECT * FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.stats')
	 EXCEPT SELECT * FROM phase13_stats_before))),
       (SELECT count(*) FROM (
	(SELECT * FROM phase13_meta_before EXCEPT
	 SELECT * FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.meta'))
	UNION ALL
	(SELECT * FROM query('SELECT * FROM ' || getvariable('atomic_schema') || '.meta')
	 EXCEPT SELECT * FROM phase13_meta_before)));
----
0	0	0

query I
SELECT count(*) FROM duckdb_tables()
WHERE database_name = 'temp' AND table_name LIKE '__ngram_%';
----
0

statement ok
DROP TABLE phase13_segments_before;

statement ok
DROP TABLE phase13_stats_before;

statement ok
DROP TABLE phase13_meta_before;

statement ok
FORCE CHECKPOINT;

# Empty indexes exercise the HWM=-1 and no-key shapes in both compaction plans.
statement ok
CREATE TABLE compact_empty(s VARCHAR);

statement ok
PRAGMA create_ngram_index('compact_empty', 's');

statement ok
SET VARIABLE compact_empty_schema = (SELECT '__ngram_idx_' || replace(index_id::VARCHAR, '-', '_')
                                     FROM __ngram.registry
                                     WHERE table_name='compact_empty' AND column_name='s');

statement ok
PRAGMA ngram_compact('compact_empty');

statement ok
PRAGMA ngram_compact('compact_empty', purge = true);

query III
SELECT hwm_rowid,
       (SELECT count(*) FROM query('SELECT * FROM ' || getvariable('compact_empty_schema') || '.segments')),
       (SELECT count(*) FROM query('SELECT * FROM ' || getvariable('compact_empty_schema') || '.stats'))
FROM query('SELECT * FROM ' || getvariable('compact_empty_schema') || '.meta');
----
-1	0	0

query I
SELECT count(*) FROM duckdb_tables()
WHERE database_name = 'temp' AND table_name LIKE '__ngram_%';
----
0

#===----------------------------------------------------------------------===#
# refusals: what maintenance will not do
#===----------------------------------------------------------------------===#

statement error
PRAGMA ngram_refresh('docs', col = NULL);
----
cannot be NULL

statement ok
CREATE TABLE unindexed(s VARCHAR);

statement error
PRAGMA ngram_refresh('unindexed');
----
no ngram index exists

statement error
PRAGMA ngram_compact('unindexed');
----
no ngram index exists

statement error
PRAGMA ngram_refresh('does_not_exist');
----
does not exist

# The C++ lifecycle harness mutates runtime UUID storage to retain the complete
# incompatible-version explicit/maintenance/stats/transparent refusal matrix.

#===----------------------------------------------------------------------===#
# shape changes while the table's identity is proven
#
# Same instance, same attach incarnation, same catalog entry: the table cannot
# have been re-created, so ALTERs to other columns say nothing about the index
# and only the indexed column's own shape matters. The mirror case — the same
# shape change with identity unproven, where it is the only recreation signal
# there is — lives in ngram_maintenance_identity.test.
#===----------------------------------------------------------------------===#

statement ok
CREATE TABLE shaped(id INTEGER, s VARCHAR);

statement ok
INSERT INTO shaped VALUES (1, 'a tent'), (2, 'no match');

statement ok
PRAGMA create_ngram_index('shaped', 's');

# a column appended at the end keeps every recorded column in place and
# preserves rowids: the index stays usable and refreshable
statement ok
ALTER TABLE shaped ADD COLUMN extra INTEGER;

query I
SELECT count(*) FROM ngram_search('shaped', 'tent');
----
1

statement ok
PRAGMA ngram_refresh('shaped');

# DuckDB's index dependency refuses removal of a physical column before the
# indexed one because that would renumber the guard's physical column id.
statement error
ALTER TABLE shaped DROP COLUMN id;
----
index depends on a column after it

query I
SELECT count(*) FROM ngram_search('shaped', 'tent');
----
1

statement ok
PRAGMA ngram_refresh('shaped');

# Type and rename ALTERs are likewise refused while any physical index depends
# on the table. Drop the ngram index first when changing its shape.
statement error
ALTER TABLE shaped ALTER COLUMN s TYPE INTEGER;
----
index depends on it

statement error
ALTER TABLE shaped RENAME COLUMN s TO renamed;
----
entries that depend on it

query I
SELECT count(*) FROM ngram_search('shaped', 'tent');
----
1

#===----------------------------------------------------------------------===#
# ownership: maintenance never runs through a shadow schema it does not own
#===----------------------------------------------------------------------===#

statement ok
CREATE SCHEMA a;

statement ok
CREATE TABLE a.b_c(s VARCHAR);

statement ok
INSERT INTO a.b_c VALUES ('a tent');

statement ok
CREATE SCHEMA a_b;

statement ok
CREATE TABLE a_b.c(s VARCHAR);

statement ok
INSERT INTO a_b.c VALUES ('another tent');

statement ok
PRAGMA create_ngram_index('a.b_c', 's');

# The old name-derived collision is gone: the foreign owner remains simply
# unindexed until it receives its own UUID allocation.
statement error
PRAGMA ngram_refresh('a_b.c');
----
no ngram index exists

statement ok
PRAGMA create_ngram_index('a_b.c', 's');

statement ok
PRAGMA ngram_refresh('a.b_c');

statement ok
PRAGMA ngram_compact('a_b.c');

query II
SELECT (SELECT count(*) FROM ngram_search('a.b_c', 'tent')),
       (SELECT count(*) FROM ngram_search('a_b.c', 'tent'));
----
1	1

#===----------------------------------------------------------------------===#
# evil identifiers survive generated SQL
#===----------------------------------------------------------------------===#

statement ok
CREATE TABLE "my.table"("sträße select" VARCHAR, "it's" INTEGER);

statement ok
INSERT INTO "my.table" VALUES ('a tent', 1);

statement ok
PRAGMA create_ngram_index('"my.table"', 'sträße select');

statement ok
INSERT INTO "my.table" VALUES ('another tent', 2);

statement ok
PRAGMA ngram_refresh('"my.table"');

statement ok
PRAGMA ngram_compact('"my.table"');

query I
SELECT count(*) FROM ngram_candidates('"my.table"', 'sträße select', 'tent');
----
2

query I
SELECT count(*) FROM ngram_search('"my.table"', 'tent');
----
2

statement ok
PRAGMA drop_ngram_index('"my.table"', 'sträße select');
