# name: test/sql/pack_segment.test
# description: ngram_pack_segment aggregate behavior
# group: [sql]

require ngram

# one output row per (gram, segment_no) group; rowids within a group need no
# ordering (the codec sorts them)
query ITIIII
SELECT gram, ngram_decode_postings(s.postings), segment_no, s.rowid_count, s.min_rowid, s.max_rowid
FROM (
	SELECT gram, seg::BIGINT AS segment_no, ngram_pack_segment(r::BIGINT) AS s
	FROM (VALUES ('abc', 0, 3), ('abc', 0, 1), ('abc', 1, 5), ('xyz', 0, 2)) t(gram, seg, r)
	GROUP BY gram, seg)
ORDER BY gram, segment_no;
----
abc	[1, 3]	0	2	1	3
abc	[5]	1	1	5	5
xyz	[2]	0	1	2	2

# duplicate rowids within a group are deduplicated; count/min/max reflect the
# deduplicated set
query ITIIII
SELECT gram, ngram_decode_postings(s.postings), segment_no, s.rowid_count, s.min_rowid, s.max_rowid
FROM (
	SELECT gram, seg::BIGINT AS segment_no, ngram_pack_segment(r::BIGINT) AS s
	FROM (VALUES ('dup', 0, 7), ('dup', 0, 7), ('dup', 0, 7), ('dup', 0, 9), ('dup', 0, 7)) t(gram, seg, r)
	GROUP BY gram, seg);
----
dup	[7, 9]	0	2	7	9

# input order does not reach the output: a group is its rowid set, and the same
# set encodes to the same bytes whatever order it arrived in. This is what makes
# the partitioned build byte-identical to an ordered pass.
query I
SELECT count(DISTINCT postings) FROM (
	SELECT ngram_pack_segment(r::BIGINT).postings AS postings
	FROM (VALUES (5), (1), (9), (1), (3)) t(r)
	UNION ALL
	SELECT ngram_pack_segment(r::BIGINT).postings
	FROM (VALUES (9), (3), (1), (5)) t(r)
	UNION ALL
	SELECT ngram_pack_segment(r::BIGINT).postings
	FROM (SELECT unnest([1, 3, 5, 9, 9, 9]) AS r));
----
1

# a rowid range wider than one segment groups per key, never across keys
query III
SELECT segment_no, s.rowid_count, s.max_rowid FROM (
	SELECT r >> 20 AS segment_no, ngram_pack_segment(r) AS s
	FROM (SELECT unnest([0::BIGINT, 1048575, 1048576, 2097151, 2097152]) AS r)
	GROUP BY r >> 20)
ORDER BY segment_no;
----
0	2	1048575
1	2	2097151
2	1	2097152

# a group no row reaches has no segment to describe
query II
SELECT gram, ngram_pack_segment(r::BIGINT) FILTER (WHERE r > 100) AS s
FROM (VALUES ('lo', 1), ('hi', 200)) t(gram, r)
GROUP BY gram ORDER BY gram;
----
hi	{'postings': \x01\x01\xC8\x01, 'rowid_count': 1, 'min_rowid': 200, 'max_rowid': 200}
lo	NULL

# empty input yields no groups
query I
SELECT count(*) FROM (
	SELECT gram, ngram_pack_segment(r) FROM (SELECT ''::VARCHAR AS gram, 0::BIGINT AS r WHERE false) GROUP BY gram);
----
0

# NULL rowids are rejected: a posting for "no row" is not a thing the index can
# hold, and silently dropping it would understate rowid_count
statement error
SELECT ngram_pack_segment(NULL::BIGINT);
----
must not contain NULLs

statement error
SELECT ngram_pack_segment(r) FROM (SELECT unnest([1::BIGINT, NULL]) AS r);
----
must not contain NULLs

# negative rowids are rejected by the codec
statement error
SELECT ngram_pack_segment(-1::BIGINT);
----
negative

# wrong argument type is a binder error
statement error
SELECT ngram_pack_segment('abc');
----
No function matches
